{
  "manifest_version": 3,
  "name": "LP Video Saver",
  "version": "0.7.0",
  "description": "開いているページで再生された動画（MP4 / HLS）を検出して保存します。",
  "permissions": [
    "webRequest",
    "webNavigation",
    "storage",
    "downloads",
    "declarativeNetRequestWithHostAccess",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LP Video Saver",
    "default_popup": "popup.html"
  }
}
